# Copy this file to .env for LOCAL use only. Never upload .env to GitHub.
# On Render, type these same names and values into the service's "Environment" page.

# PostgreSQL connection (Neon / Render links starting with postgresql:// also work)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/openlane

# Signs login sessions. Make one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# true when the site runs on HTTPS (Render = true)
COOKIE_SECURE=false

# Development only: shows the reset code on screen. Must be false in production.
SHOW_RESET_CODE=true

# --- Sending reset codes by email ---
# Option 1 (use this on Render): Brevo email API over HTTPS
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM_EMAIL=youraddress@gmail.com     (must be a verified sender in Brevo)
# MAIL_FROM_NAME=OpenLane

# Option 2 (only where SMTP ports are open, e.g. your own PC): Gmail SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=OpenLane <youraddress@gmail.com>
